# ====================================================================
# PHISHGUARD Environment Configuration Template
# Copy this file to .env and provide your deployment-specific values.
# ====================================================================

# Application Environment & Security
ENVIRONMENT=development
SECRET_KEY=phishguard-dev-only-secret-key-change-in-production
DATABASE_URL=sqlite:///./data/phishguard.db

# Optional AI Security Analyst Configuration
# If LLM_API_KEY / GEMINI_API_KEY is not set, PHISHGUARD uses built-in deterministic analysis.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Google Gemini AI Security Analyst (preferred when set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# VirusTotal Threat Intelligence API (Optional)
VIRUSTOTAL_API_KEY=

# Email OTP & SMTP Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Mailbox Token Encryption Key (Fernet key for encrypted mailbox sync)
MAILBOX_TOKEN_ENCRYPTION_KEY=

# Google Cloud & Gmail OAuth (Optional for Gmail Integration)
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Pub/Sub Push Webhook (Optional)
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
GOOGLE_PUBSUB_AUDIENCE=

# Frontend Web Application URL
FRONTEND_URL=http://localhost:5173
